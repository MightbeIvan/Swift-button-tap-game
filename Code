import SwiftUI

struct ContentView: View {
    
    @State private var currentScreen = "menu"
    
    // Game state
    @State private var score = 0
    @State private var targetNumber = Int.random(in: 5...20)
    @State private var gameActive = false
    @State private var message = "Press Start"
    
    @State private var timeLeft = 10
    @State private var timer: Timer?
    
    //Shows which screen starts first (starting screen)
    var body: some View {
        switch currentScreen {
        case "menu":
            startScreen
        case "game":
            gameScreen
        case "leaderboard":
            leaderboardScreen
        case "credits":
            creditsScreen
        default:
            startScreen
        }
    }
    
    // Starting screen
    var startScreen: some View {
        VStack(spacing: 50) {
            
            Spacer(minLength: 20)
            
            Text("Number Tap Guessing Game")
                .font(.largeTitle)
            
            Text("Tap to try to guess a hidden number before time runs out!")
                .multilineTextAlignment(.center)
                .padding(.horizontal)
            
            Button(action: {
                currentScreen = "game"
            }) {
                Text("Start Game")
                    .font(.title)
                    .padding()
                    .frame(maxWidth: .infinity)
                    .background(Color.green)
                    .foregroundColor(.white)
                    .cornerRadius(12)
            }
            
            HStack(spacing: 30) {
                Button(action: {
                    currentScreen = "leaderboard"
                }) {
                    Image(systemName: "list.star")
                        .resizable()
                        .scaledToFit()
                        .frame(width: 50, height: 50)
                        .padding()
                        .background(Color.blue.opacity(0.7))
                        .foregroundColor(.white)
                        .cornerRadius(12)
                }
                
                Button(action: {
                    currentScreen = "credits"
                }) {
                    Image(systemName: "person.crop.circle")
                        .resizable()
                        .scaledToFit()
                        .frame(width: 50, height: 50)
                        .padding()
                        .background(Color.purple.opacity(0.7))
                        .foregroundColor(.white)
                        .cornerRadius(12)
                }
            }
            
            Spacer()
        }
        .padding()
    }
    
    //Main Game Screen
    var gameScreen: some View {
        VStack(spacing: 40) {
            Spacer(minLength: 50)
            
            Text("Time: \(timeLeft)")
                .font(.largeTitle)
                .foregroundColor(timeLeft <= 3 ? .red : .primary)
            
            Text("Score: \(score)")
                .font(.title)
            
            Text(message)
                .font(.title2)
                .foregroundColor(.gray)
            
            Button(action: tapButton) {
                Text("Tap Me!")
                    .font(.title)
                    .padding()
                    .frame(maxWidth: .infinity)
                    .background(Color.blue)
                    .foregroundColor(.white)
                    .cornerRadius(10)
            }
            .disabled(!gameActive)
            
            // Start / Reset button
            Button(action: {
                if !gameActive { // Start the game
                    startGame()
                } else { // Reset the game
                    resetGame()
                }
            }) {
                Text(gameActive ? "Reset" : "Start")
                    .font(.title2)
                    .padding()
                    .frame(maxWidth: .infinity)
                    .background(gameActive ? Color.red : Color.green)
                    .foregroundColor(.white)
                    .cornerRadius(10)
            }
            
            Button(action: finishGame) {
                Text("Finish")
                    .font(.title2)
                    .padding()
                    .frame(maxWidth: .infinity)
                    .background(Color.orange)
                    .foregroundColor(.white)
                    .cornerRadius(10)
            }
            .disabled(!gameActive)
            
            HStack(spacing: 30) {
                Button(action: {
                    currentScreen = "leaderboard"
                }) {
                    Image(systemName: "list.star")
                        .resizable()
                        .scaledToFit()
                        .frame(width: 40, height: 40)
                        .padding()
                        .background(Color.blue.opacity(0.7))
                        .foregroundColor(.white)
                        .cornerRadius(12)
                }
                
                Button(action: {
                    currentScreen = "menu"
                    endGame()
                }) {
                    Image(systemName: "house.fill")
                        .resizable()
                        .scaledToFit()
                        .frame(width: 40, height: 40)
                        .padding()
                        .background(Color.gray.opacity(0.7))
                        .foregroundColor(.white)
                        .cornerRadius(12)
                }
            }
            
            Spacer()
        }
        .padding()
    }
    
    // Leaderboard Screen
    var leaderboardScreen: some View {
        VStack(spacing: 30) {
            
            Text("Leaderboard")
                .font(.largeTitle)
            
            Text("(Nothing here yet)")
                .foregroundColor(.gray)
            
            Spacer()
            
            Button(action: {
                currentScreen = "menu"
            }) {
                Text("Back to Menu")
                    .font(.title2)
            }
        }
        .padding()
    }
    
    // Credits Screen
    var creditsScreen: some View {
        VStack(spacing: 30) {
            
            Text("Credits")
                .font(.largeTitle)
            
            Spacer()
            
            Text("Made by @mightbeivan")
                .font(.title3)
                .bold()
            
            Spacer()
            
            Button(action: {
                currentScreen = "menu"
            }) {
                Text("Back to Menu")
                    .font(.title2)
            }
        }
        .padding()
    }
    
    // Game Algorythym
    func startGame() {
        score = 0
        targetNumber = Int.random(in: 5...20)
        gameActive = true
        message = "Find the number!"
        timeLeft = 10
        
        timer?.invalidate()
        timer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { _ in
            DispatchQueue.main.async {
                if timeLeft > 0 {
                    timeLeft -= 1
                } else {
                    finishGame()
                }
            }
        }
    }
    
    func resetGame() {
        endGame()
        score = 0
        timeLeft = 10
        message = "Press Start"
    }
    
    //functions     
    func tapButton() {
        guard gameActive else { return }
        score += 1
    }
    
    func finishGame() {
        let difference = score - targetNumber
        
        if score == targetNumber {
            message = "Perfect! It was \(targetNumber)"
        } else if score < targetNumber {
            message = "Too low! Target was \(targetNumber)"
        } else {
            if difference <= 2 {
                message = "So close! Over by \(difference)"
            } else {
                message = "Too high! Target was \(targetNumber)"
            }
        }
        
        endGame()
    }
    
    func endGame() {
        gameActive = false
        timer?.invalidate()
    }
}

